/*
Implement the method fullNames that takes as input two equal-sized lists of strings firstNames and lastNames, 
and returns a new list containing full names, with each 
full name generated by the concatenating the first name and last name at the corresponding location in the input lists.
*/

public List<String> fullNames(List<String> firstNames, List<String> lastNames) {
    List<String> fullNames = new List<String>();

    if(firstNames != null || lastNames != null){
        for(Integer i = 0; i < firstNames.size(); i++){
            String name = firstNames.get(i) + ' ' + lastNames.get(i);
            fullNames.add(name);
        }
    } 

    return fullNames;
}

